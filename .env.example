# JANSAATHI AI - Environment Variable Configuration Template
# All client-safe variables must be prefixed with VITE_

# 1. Supabase PostgreSQL & Auth Configuration (Required for cloud persistence)
# Obtain from your Supabase Project Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# 2. AI Provider (Optional: Google Gemini 2.0 / 1.5 Flash Free Tier)
# If omitted or left blank, JANSAATHI automatically uses its built-in offline Deterministic Extractor.
# Obtain from Google AI Studio (https://aistudio.google.com)
VITE_GEMINI_API_KEY=

# 3. Application Operational Environment
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0
